/* 
  Practica 2 - Pipelines CI/CD en Jenkins con Docker y Groovy

*/

// ==========================
// Practica 2 - Ejercicio 4
// ==========================
def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()  
    }
}
 
pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  // ==========================
  // Practica 2 - Ejercicio 6.3
  // ==========================
  parameters {
    booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD')
  }

  // ==========================
  // Practica 2 - Ejercicio 6.4
  // ==========================
  environment {
    // IMAGE_NAME
	  //IMAGE_NAME = "myapp:${env.BUILD_NUMBER}"
    // IMAGE REPO LOCAL
    IMAGE_REPO_LOCAL = 'scalian_training-java-hello-world'
    IMAGE_TAG  = "0.0.2"
    APP_URL = "http://localhost:5001/"
  }

  stages {

    // ==========================
    // Practica 2 - Ejercicio 1
    // ==========================
    stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
                echo "Imagen: ${env.IMAGE_REPO_LOCAL}"
                sh "echo URL=${APP_URL}"
            }
    }

    // ==========================
    // Practica 2 - Ejercicio 3
    // ==========================
    stage('Build CI Image') {
      steps {
        script {
          // Construir imagen CI para ejecutar 'make link' y 'make test'
          // Nombre: 'java-imagen-ci'
          docker.build('java-imagen-ci', '-f devops/ci.Dockerfile .')
        }
      }
    }

    // =============================
    // Practica 2 - Ejercicio 3 - 4
    // =============================
    stage('Lint') {
      steps {
        script {
          runInDocker('java-imagen-ci') {
            // Detecta errores de estilo
            sh 'make lint'
          }
        }
      }
    }

    // =============================
    // Practica 2 - Ejercicio 3 - 4
    // =============================
    stage('Test') {
      steps {
        script {
          runInDocker('java-imagen-ci') {
            // Detecta errores de test
            sh 'make test'
          }
        }
      }
    }

    // =========================
    // Practica 2 - Ejercicio 5
    // =========================
    stage('Build image') {
      steps {
        script {
          def version   = "${IMAGE_REPO_LOCAL}:${IMAGE_TAG}"
          // Construye la imagen Docker usando el Dockerfile del repo
          docker.build("${version}", "--build-arg VERSION=${version} -f devops/Dockerfile .")
        }
      }
    }

    // ===========================================
    // Practica 2 - Ejercicio 6 - 6.1 - 6.2 - 6.3
    // ===========================================
    stage('CD') {
      when {
        anyOf {
          expression { return params.RUN_CD }
          branch 'develop'
          branch 'master'
        }
      }
      steps {
        echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"

        script {
          // Determinar entorno según la rama
          env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'PRO' : 'DEV'

          // Mostrar mensaje en logs
          echo "Deploying to ${env.DEPLOY_ENV}"

          // Levanta el contenedor definido en docker-compose.yml
          // Espera 5 segundos
          // Muestra los logs
          sh 'docker compose up -d'
          sh 'sleep 5'
          sh 'docker compose logs java_app'
        }
      }
      post {
        always {
            // Elimina contenedor
            sh 'docker compose down --volumes'
            sh 'docker rmi ${IMAGE_REPO_LOCAL}:${IMAGE_TAG} || true'
        }
        success {
          // Imprime SUCCESS
          echo 'SUCCESS'
        }
        failure {
          // Imprime FAILURE y muestra logs
          echo 'FAILURE'
          sh 'docker compose logs || true'
        }
      }
    }
    
  }
}
