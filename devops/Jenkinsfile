/* 
  Practica 2 - Pipelines CI/CD en Jenkins con Docker y Groovy

*/

// ==========================
// Practica 2 - Ejercicio 4
// ==========================
def runInDocker(String image, Closure body) {
    docker.image(image).inside {
        body()  
    }
}
 
pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

  environment {
    // IMAGE_NAME (tag para docker build)
	  IMAGE_NAME = "myapp:${env.BUILD_NUMBER}"
  }

  stages {

    // ==========================
    // Practica 2 - Ejercicio 1
    // ==========================
    stage('Info') {
            steps {
                echo "Job: ${env.JOB_NAME}"
                echo "Build: ${env.BUILD_NUMBER}"
            }
        }

    // ==========================
    // Practica 2 - Ejercicio 3
    // ==========================
    stage('Build CI Image') {
      steps {
        script {
          // Construir imagen CI para ejecutar 'make link' y 'make test'
          // Nombre: 'java-imagen-ci'
          docker.build('java-imagen-ci', '-f devops/ci.Dockerfile .')
        }
      }
    }

    // =============================
    // Practica 2 - Ejercicio 3 - 4
    // =============================
    stage('Lint') {
      steps {
        script {
          runInDocker('java-imagen-ci') {
            // Detecta errores de estilo
            sh 'make lint'
          }
        }
      }
    }

    // =============================
    // Practica 2 - Ejercicio 3 - 4
    // =============================
    stage('Test') {
      steps {
        script {
          runInDocker('java-imagen-ci') {
            // Detecta errores de test
            sh 'make test'
          }
        }
      }
    }

    // =========================
    // Practica 2 - Ejercicio 5
    // =========================
    stage('Build image') {
      steps {
        script {
          def version = "1.0.${env.IMAGE_NAME}"
          // Construye la imagen Docker usando el Dockerfile del repo
          docker.build("${version}", "--build-arg VERSION=${version} -f devops/Dockerfile .")
        }
      }
    }

    // =========================
    // Practica 2 - Ejercicio 6
    // =========================
    stage('CD') {
      steps {
        // Levanta el contenedor definido en docker-compose.yml
        // Espera 5 segundos
        // Muestra los logs
        sh 'docker compose up -d'
        sh 'sleep 5'
        sh 'docker compose logs java_app'
      }
      post {
        always {
            // Elimina contenedor
            sh 'docker compose down --volumes'
        }
      }
    }
    
  }
}
